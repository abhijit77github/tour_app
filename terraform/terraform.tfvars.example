# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

kubernetes_namespace = "tour-app"
app_name             = "tour-app"
environment          = "dev"
frontend_url_override = ""

# MongoDB Configuration
mongodb_version      = "7.0"
mongodb_storage_size = "10Gi"
mongodb_replica_count = 1  # Use 3+ for production

# Backend Configuration
backend_replicas      = 2
backend_port          = 8808
backend_image_tag     = "latest"
database_name         = "tour_app_db"
backend_cpu_request   = "100m"
backend_cpu_limit     = "500m"
backend_memory_request = "256Mi"
backend_memory_limit   = "512Mi"

# Frontend Configuration
frontend_replicas     = 2
frontend_port         = 5173
frontend_image_tag    = "latest"
frontend_cpu_request  = "50m"
frontend_cpu_limit    = "200m"
frontend_memory_request = "128Mi"
frontend_memory_limit   = "256Mi"

# Domain Configuration
domain_name      = "tour-app.local"
backend_subdomain = "api"
ingress_class_name = "nginx"
client_max_body_size = "10m"

# Docker Registry (optional, for private registries)
docker_registry           = "docker.io"
# docker_registry_username = "your-username"
# docker_registry_password = "your-password"
# docker_registry_email    = "your-email@example.com"
