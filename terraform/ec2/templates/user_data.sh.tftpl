#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl gnupg nginx unzip %{ if enable_tls }certbot python3-certbot-nginx%{ endif }

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$${ARCH} signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${CODENAME} stable" > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

if ! command -v aws >/dev/null 2>&1; then
	tmp_dir=$(mktemp -d)
	curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "$tmp_dir/awscliv2.zip"
	unzip -q "$tmp_dir/awscliv2.zip" -d "$tmp_dir"
	"$tmp_dir/aws/install"
	rm -rf "$tmp_dir"
fi

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

mkdir -p ${app_dir}
mkdir -p /var/www/certbot

echo '${compose_content}' | base64 -d > ${app_dir}/docker-compose.yml
echo '${nginx_content}' | base64 -d > /etc/nginx/conf.d/tour-app.conf

rm -f /etc/nginx/sites-enabled/default || true
nginx -t
systemctl enable nginx
systemctl restart nginx

%{ if enable_tls }
if [[ "${domain_name}" == "_" || -z "${tls_email}" ]]; then
	echo "TLS requires a real domain_name and tls_email" >&2
	exit 1
fi

certbot --nginx --non-interactive --agree-tos -m "${tls_email}" -d "${domain_name}" --redirect
systemctl reload nginx
%{ endif }

cd ${app_dir}
BACKEND_IMAGE='${backend_image}'
FRONTEND_IMAGE='${frontend_image}'

for image in "$BACKEND_IMAGE" "$FRONTEND_IMAGE"; do
	registry=$(printf '%s\n' "$image" | cut -d/ -f1)
	aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin "$registry"
done

docker compose pull
docker compose up -d